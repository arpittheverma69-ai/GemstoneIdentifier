{
  "expo": {
    "name": "GemSpy",
    "slug": "GemX",
    "version": "1.0.0",
    "description": "GemSpy is your professional gemstone identification and business management app powered by AI. Identify gemstones, manage inventory, and generate certificates with ease.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gemaipro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gemaipro.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photos to upload gemstone images.",
        "NSCameraUsageDescription": "We need access to your camera to take photos of gemstones.",
        "NSPhotoLibraryAddUsageDescription": "We need permission to save gemstone images to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B46C1",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gemaipro.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6B46C1",
          "dark": {
            "backgroundColor": "#1F2123"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://tgwxpyfespesfnqadnpn.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRnd3hweWZlc3Blc2ZucWFkbnBuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk3NTc2MTgsImV4cCI6MjA4NTMzMzYxOH0.N8IS0J58Vgy33GLvQTkmpLbYg9tkQF9Isqefe727ym0",
      "eas": {
        "projectId": "0475a416-d77c-4053-9616-de37b557b5ab"
      }
    },
    "owner": "arpitwillgetit",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0475a416-d77c-4053-9616-de37b557b5ab"
    }
  }
