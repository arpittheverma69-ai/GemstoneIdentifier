{
  "expo": {
    "name": "GemAI Pro",
    "slug": "gemaid-pro",
    "version": "1.0.0",
    "description": "Professional gemstone identification and business management app powered by AI. Identify gemstones, manage inventory, and generate certificates.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gemaipro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gemaipro.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photos to upload gemstone images.",
        "NSCameraUsageDescription": "We need access to your camera to take photos of gemstones.",
        "NSPhotoLibraryAddUsageDescription": "We need permission to save gemstone images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B46C1",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gemaipro.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6B46C1",
          "dark": {
            "backgroundColor": "#1F2123"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://qwdshcurrksnqqrbzseu.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF3ZHNoY3VycmtzbnFxcmJ6c2V1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjUwMzU3MzYsImV4cCI6MjA4MDYxMTczNn0.78vnhdFLvUGBZ3uUuxseysmNvf0E_YDg4y8xLwOf74I"
    }
  }
}
